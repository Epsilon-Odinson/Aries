# Copy to .env for LOCAL development only. Never commit a real .env.
# On Render, set these in the dashboard (Environment), never in code.
NVIDIA_API_KEY=
# Optional: Postgres URL for durable data. Leave unset for local SQLite.
DATABASE_URL=
# Optional: chat model override (default nvidia/nemotron-3.5-lightning-30b-a3b).
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional: vision model for screenshot description. Leave unset until
# meta/llama-3.2-11b-vision-instruct is verified live on NVIDIA hosting.
VISION_MODEL=
# Local dev only: where the Vite dev server runs (default http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
